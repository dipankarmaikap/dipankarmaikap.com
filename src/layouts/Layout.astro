---
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import "~/tailwind.css";
import { siteUrl } from "~/utils/variables";

const feedUrl = siteUrl + "rss.xml";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <slot name="meta">
      <title>Dipankar Maikap</title>
      <meta name="description" content="Web Developer & Technical writer" />
    </slot>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Dipankar Maikap » RSS Feed"
      href={feedUrl}
    />
    <script
      defer
      data-domain="dipankarmaikap.com"
      src="https://plausible.dip2.in/js/script.js"></script>
  </head>
  <body
    class="font-serif text-neutral-700 dark:text-neutral-200 dark:bg-neutral-900"
  >
    <Header />
    <slot />
    <Footer />
  </body>
</html>
