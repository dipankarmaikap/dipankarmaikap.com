---
import Logo from "~/components/Logo.astro";
import MainNavigation from "~/components/MainNavigation.astro";
import ThemeIcon from "~/components/ThemeIcon.astro";
---

<header class="border-b border-gray-200 dark:border-neutral-700">
  <div class="max-w-screen-md mx-auto px-4 py-2 md:py-5">
    <div class="flex justify-between items-center">
      <Logo />
      <div class="last flex gap-4 items-center">
        <div class="nav hidden sm:block">
          <MainNavigation />
        </div>
        <ThemeIcon />
      </div>
    </div>
    <div class="nav sm:hidden">
      <MainNavigation />
    </div>
  </div>
</header>
