---
import { render, type CollectionEntry } from "astro:content";
import { fburl, authorName, mySchema } from "~/utils/variables";
interface Props {
  post: CollectionEntry<"post">;
}
const { post } = Astro.props;
const { remarkPluginFrontmatter } = await render(post);
// console.log(post.rendered?.metadata);

const siteUrl = Astro.site || "https://dipankarmaikap.com";
const title = post.data.title;
const description = post.data.description;
const canonicalUrl = siteUrl + post.id + "/";
const imageUrl = siteUrl + post.data?.image?.url;

const language = "en_US";
const datePublished = post.data.pubDate.toISOString();
const dateModified =
  post.data?.updatedDate?.toISOString() || post.data.pubDate.toISOString();
const { "@context": _, ...author } = mySchema;
console.log(remarkPluginFrontmatter);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": canonicalUrl,
  headline: title,
  description,
  image: {
    "@type": "ImageObject",
    url: imageUrl,
    width: 1640,
    height: 856,
  },
  author,
  publisher: {
    ...author,
    logo: {
      "@type": "ImageObject",
      url: "https://dipankarmaikap.com/logo.png",
      width: 600,
      height: 60,
    },
  },
  url: canonicalUrl,
  datePublished: datePublished,
  dateModified: dateModified,
  articleSection: "Web Development",
  keywords: post.data.tags,
  wordCount: remarkPluginFrontmatter.words,
  timeRequired: `PT${remarkPluginFrontmatter.minutes}M`, // Fixed format
};

const articleJson = JSON.stringify(articleSchema, null, 2)
---

<!-- Primary SEO Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={post.data.tags.join(", ")} />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph (Facebook, LinkedIn, etc.) -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={authorName} />
<meta property="og:locale" content={language} />
<meta property="og:type" content="article" />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1640" />
<meta property="og:image:height" content="856" />

<!-- Article Metadata (Open Graph) -->
<meta property="article:author" content={fburl} />
<meta property="article:publisher" content={fburl} />
<meta property="article:section" content="Web Development" />
<meta property="article:tag" content={post.data.tags.join(", ")} />
<meta property="article:published_time" content={datePublished} />
<meta property="article:modified_time" content={dateModified} />

<!-- Twitter Metadata -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@maikap_dipankar" />
<meta name="twitter:creator" content="@maikap_dipankar" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<!-- Extra Twitter Metadata -->
<meta name="twitter:label1" content="Written by" />
<meta name="twitter:data1" content={authorName} />
<meta name="twitter:label2" content="Reading Time" />
<meta name="twitter:data2" content={remarkPluginFrontmatter.minutesRead} />

<!-- Dublin Core Metadata (Not essential for SEO but useful for libraries and archives) -->
<meta name="dc.title" content={title} />
<meta name="dc.description" content={description} />
<meta name="dc.relation" content={canonicalUrl} />
<meta name="dc.source" content={siteUrl} />
<meta name="dc.language" content={language} />
<meta name="dc.date" content={datePublished} />
<meta name="dc.date.modified" content={dateModified} />

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" set:html={articleJson}>
</script>