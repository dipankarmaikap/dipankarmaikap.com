---
import { getEntry } from "astro:content";
import { render, type CollectionEntry } from "astro:content";
import { siteUrl } from "~/utils/variables";
import {
  fburl,
  authorName,
  author,
  publisher,
  fallbackImageUrl,
} from "~/utils/variables";
interface Props {
  post: CollectionEntry<"post">;
}
const { post } = Astro.props;
const { remarkPluginFrontmatter } = await render(post);
const title = post.data.title;
const description = post.data.description;
const canonicalUrl = new URL(post.id + "/", siteUrl).href;
const imageUrl = new URL(post.data?.image || fallbackImageUrl, siteUrl).href;
const language = "en_US";
const datePublished = post.data.pubDate.toISOString();
const dateModified =
  post.data?.updatedDate?.toISOString() || post.data.pubDate.toISOString();
const category = await getEntry("category", post.data.category);
const categoryName = category?.data.title || "Web Development";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": canonicalUrl,
  headline: title,
  description,
  isPartOf: {
    "@type": "WebSite",
    url: siteUrl,
    name: "Dipankar Maikap",
  },
  image: {
    "@type": "ImageObject",
    url: imageUrl,
    width: 1200,
    height: 630,
  },
  author,
  publisher,
  url: canonicalUrl,
  datePublished: datePublished,
  dateModified: dateModified,
  articleSection: categoryName,
  keywords: post.data.tags,
  wordCount: remarkPluginFrontmatter.words,
  timeRequired: `PT${remarkPluginFrontmatter.minutes}M`,
  potentialAction: [
    {
      "@type": "ReadAction",
      target: canonicalUrl,
    },
    {
      "@type": "ShareAction",
      target: [
        `https://x.com/intent/tweet?url=${canonicalUrl}`,
        `https://www.facebook.com/sharer/sharer.php?u=${canonicalUrl}`,
        `https://www.linkedin.com/shareArticle?mini=true&url=${canonicalUrl}`,
        `https://pinterest.com/pin/create/button/?url=${canonicalUrl}`,
        `https://www.reddit.com/submit?url=${canonicalUrl}`,
      ],
    },
  ],
};

const articleJson = JSON.stringify(articleSchema);
---

<!-- Primary SEO Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={post.data.tags.join(", ")} />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph (Facebook, LinkedIn, etc.) -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={authorName} />
<meta property="og:locale" content={language} />
<meta property="og:type" content="article" />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Article Metadata (Open Graph) -->
<meta property="article:author" content={fburl} />
<meta property="article:publisher" content={fburl} />
<meta property="article:section" content={categoryName} />
<meta property="article:tag" content={post.data.tags.join(", ")} />
<meta property="article:published_time" content={datePublished} />
<meta property="article:modified_time" content={dateModified} />

<!-- Twitter Metadata -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@maikap_dipankar" />
<meta name="twitter:creator" content="@maikap_dipankar" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<!-- Extra Twitter Metadata -->
<meta name="twitter:label1" content="Written by" />
<meta name="twitter:data1" content={authorName} />
<meta name="twitter:label2" content="Reading Time" />
<meta name="twitter:data2" content={remarkPluginFrontmatter.minutesRead} />

<!-- Dublin Core Metadata (Not essential for SEO but useful for libraries and archives) -->
<meta name="dc.title" content={title} />
<meta name="dc.description" content={description} />
<meta name="dc.relation" content={canonicalUrl} />
<meta name="dc.source" content={siteUrl} />
<meta name="dc.language" content={language} />
<meta name="dc.date" content={datePublished} />
<meta name="dc.date.modified" content={dateModified} />

<!-- Schema.org JSON-LD -->
<script is:inline type="application/ld+json" set:html={articleJson} />
