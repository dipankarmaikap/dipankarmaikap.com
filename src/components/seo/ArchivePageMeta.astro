---
import PageMetadata from "~/components/seo/PageMetadata.astro";
import { siteUrl } from "~/utils/variables";
interface Props {
  hasPrev: boolean;
  hasNext: boolean;
  pageNo: number;
  title: string;
  description: string;
  path: string;
  image?: string;
}
const { hasPrev, hasNext, pageNo, title, description, path, image } =
  Astro.props;

const getPageUrl = (page: number) =>
  `${siteUrl}${page === 1 ? "" : `page/${page}/`}`;
---

<PageMetadata {title} {description} {path} {image} />

<!-- Paginated Links -->
{hasPrev && <link rel="prev" href={getPageUrl(pageNo - 1)} />}
{hasNext && <link rel="next" href={getPageUrl(pageNo + 1)} />}
