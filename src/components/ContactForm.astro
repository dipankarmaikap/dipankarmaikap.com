---

---

<form id="contactForm" class="flex flex-col gap-4 mt-4">
  <div class="form-group">
    <label class="flex" for="name">Name</label>
    <input
      class="ring ring-gray-300 focus:outline-none focus:ring-blue-600 p-1 mt-1 flex w-full"
      type="text"
      name="name"
      id="name"
      required
    />
  </div>
  <div class="form-group">
    <label class="flex" for="email">Email</label>
    <input
      class="ring ring-gray-300 focus:outline-none focus:ring-blue-600 p-1 mt-1 flex w-full"
      type="email"
      name="email"
      id="email"
      required
    />
  </div>
  <div class="form-group">
    <label class="flex" for="message">Message</label>
    <textarea
      class="ring ring-gray-300 focus:outline-none focus:ring-blue-600 p-1 mt-1 flex w-full"
      name="email"
      id="message"
      required
      rows="4"></textarea>
  </div>
  <div class="flex mt-2">
    <button
      class="bg-blue-600 hover:bg-blue-700 text-white p-2 cursor-pointer px-6"
      >Send message</button
    >
  </div>
</form>
