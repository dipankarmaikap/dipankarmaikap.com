---
interface Props {
  name: string;
}
---

<div class="bg-[#1b1f23] text-neutral-300 relative -mb-5 rounded-t-sm h-9">
  <div class="absolute z-10 inset-0 border-b border-neutral-700">
    <div class="px-2 mt-0.5">
      <div class="flex items-center justify-between">
        <p style="margin:0;padding:0">{Astro.props.name}</p>
        <div class="flex gap-2">
          <span class="bg-red-500 size-3 block rounded-full"></span>
          <span class="bg-yellow-500 size-3 block rounded-full"></span>
          <span class="bg-green-500 size-3 block rounded-full"></span>
        </div>
      </div>
    </div>
  </div>
</div>
