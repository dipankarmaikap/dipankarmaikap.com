---
import { Image } from "astro:assets";
import AuthorImage from "~/assets/dipankar-maikap.jpg";
---

<div class="author p-4 mt-8 flex flex-col gap-3 items-center text-center">
  <Image src={AuthorImage} alt="Dipankar Maikap" class="size-24" />
  <div>
    <h4 class="text-3xl font-bold mb-2">About the Author</h4>
    <p style={{ margin: 0 }}>
      Hey, I'm <a href="/about/" class="text-blue-600 hover:underline"
        ><b>Dipankar Maikap</b></a
      >! I’m passionate about web development, JavaScript, and optimizing web
      performance. I love sharing what I learn to help fellow developers build
      better, faster websites.
    </p>
  </div>
</div>
