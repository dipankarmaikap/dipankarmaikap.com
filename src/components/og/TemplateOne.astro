---
import { siteUrl } from "~/utils/variables";

interface Props {
  title: string;
}
const { title } = Astro.props;
function wrapText(text: string, maxCharsPerLine: number) {
  const words = text.split(" ");
  let lines = [];
  let line = "";

  for (const word of words) {
    if ((line + word).length > maxCharsPerLine) {
      lines.push(line.trim());
      line = word + " ";
    } else {
      line += word + " ";
    }
  }

  if (line.trim()) lines.push(line.trim());

  return lines;
}
const maxCharsPerLine = 50; // Adjust based on font size
const lines = wrapText(title, maxCharsPerLine);
---

<svg
  width="1200"
  height="630"
  viewBox="0 0 1200 630"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Background -->
  <rect width="100%" height="100%" fill="#fffaf4"></rect>

  <!-- Title -->
  <text
    x="50%"
    y="35%"
    font-family="Inter, sans-serif"
    font-size="48"
    fill="#333"
    text-anchor="middle"
    dominant-baseline="middle"
  >
    {
      lines.map((line, i) => (
        <tspan x="50%" dy={i === 0 ? "0" : "1.2em"}>
          {line}
        </tspan>
      ))
    }
  </text>

  <!-- Writer Section -->
  <image
    href={siteUrl + "images/dipankar-maikap.jpg"}
    x="570"
    y="450"
    width="60"
    height="60"
    clip-path="circle(50%)"
  />
  <text
    x="600"
    y="535"
    font-family="Inter, sans-serif"
    font-size="32"
    fill="#333"
    margin-top="5px"
    text-anchor="middle"
    dominant-baseline="middle"
  >
    Dipanakr Maikap
  </text>
</svg>
