---
import type { BundledLanguage } from "shiki";
import CodeSnippet from "./CodeSnippet.astro";
import { codeExamples } from "./data";
interface Props {
  title: string;
  description?: string;
  date?: string;
  category?: string;
  code?: string;
  filename?: string;
  language?: BundledLanguage;
}

const {
  title,
  category = "ARTICLE",
  code = "",
  filename = "src/index.ts",
  language = "typescript",
} = Astro.props;

function wrapText(text: string, maxChars: number) {
  const words = text.split(" ");
  const lines: string[] = [];
  let line = "";

  for (const word of words) {
    if ((line + word).length > maxChars) {
      lines.push(line.trim());
      line = word + " ";
    } else {
      line += word + " ";
    }
  }

  if (line.trim()) lines.push(line.trim());

  return lines;
}

const titleLines = wrapText(title, code ? 22 : 28);

const example = codeExamples[Math.floor(Math.random() * codeExamples.length)];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="1200"
  height="630"
  viewBox="0 0 1200 630"
>
  <!-- background -->
  <rect width="1200" height="630" fill="#ffffff"></rect>

  <!-- border -->
  <rect
    x="16"
    y="16"
    width="1168"
    height="598"
    fill="none"
    stroke="#111"
    stroke-width="2"></rect>

  <!-- header -->
  <text
    x="70"
    y="90"
    font-size="34"
    font-family="'IBM Plex Mono', monospace"
    font-weight="700"
    fill="#111"
  >
    Dipankar Maikap
  </text>

  <text
    x="70"
    y="125"
    font-size="18"
    font-family="'JetBrains Mono', monospace"
    fill="#444"
  >
    Developer Experience Engineer · Technical Writer
  </text>

  <text
    x="1110"
    y="90"
    text-anchor="end"
    font-size="44"
    font-family="'IBM Plex Mono', monospace"
    fill="#111"
  >
    &lt;/&gt;
  </text>

  <!-- category -->

  <text
    x="70"
    y="205"
    font-size="18"
    font-weight="700"
    fill="#2155ff"
    font-family="'IBM Plex Mono', monospace"
  >
    {category.toUpperCase()}
  </text>

  <!-- title -->

  <text
    x="70"
    y="285"
    font-size="52"
    font-weight="700"
    fill="#111"
    font-family="'IBM Plex Mono', monospace"
  >
    {
      titleLines.map((line, index) => (
        <tspan x="70" dy={index === 0 ? 0 : 64}>
          {line}
        </tspan>
      ))
    }
  </text>
  <CodeSnippet
    filename={code.length > 0 ? filename : example.filename}
    language={code.length > 0 ? language : example.language}
    code={code.length > 0 ? code : example.code}
  />

  <!-- footer line -->

  <line x1="70" y1="560" x2="1130" y2="560" stroke="#111"></line>

  <!-- footer -->

  <text
    x="70"
    y="595"
    font-size="18"
    fill="#111"
    font-family="'IBM Plex Mono', monospace"
  >
    dipankarmaikap.com
  </text>

  <text
    x="1130"
    y="595"
    text-anchor="end"
    font-size="18"
    fill="#111"
    font-family="'IBM Plex Mono', monospace"
  >
    Built with <tspan fill="#e11d48">❤</tspan> and passion
  </text>
</svg>
