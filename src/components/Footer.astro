---
import Email from "~/components/social/Email.astro";
import Github from "~/components/social/Github.astro";
import Twitter from "~/components/social/Twitter.astro";
import Youtube from "~/components/social/Youtube.astro";
---

<footer class="site-footer mt-12">
  <div
    class="max-w-screen-md mx-auto p-4 text-lg border-t border-neutral-200 text-center"
  >
    <p class="py-4">
      Copyright @ <span id="current_year" class="current-year">2025</span>.
      Website designed and developed by
      <a class="hover:underline text-blue-600" href={Astro.site}>me.</a>
    </p>
    <ul class="flex gap-4 justify-center">
      <li><Email /></li>
      <li><Github /></li>
      <li><Twitter /></li>
      <li><Youtube /></li>
    </ul>
  </div>
</footer>
