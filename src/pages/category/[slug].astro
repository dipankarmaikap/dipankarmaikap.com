---
import Layout from "~/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { render } from "astro:content";
import { getPosts } from "~/utils/getPosts";
import PostCard from "~/components/post/PostCard.astro";
import PageMetadata from "~/components/seo/PageMetadata.astro";

export const prerender = true;
export async function getStaticPaths() {
  const categories = await getCollection("category");
  return categories.map((category) => {
    return { params: { slug: category.id }, props: { category } };
  });
}
const { category } = Astro.props;

const posts = await getPosts();
const postsInCategory = posts.filter(
  (post) => post.data.category === category.id
);

const { Content } = await render(category);
---

<Layout>
  <PageMetadata
    slot="meta"
    title={category.data.seoTitle ||
      `${category.data.title} Guides & Tutorials – Development, Optimization & Best Practices`}
    description={category.data.description}
    path={`/category/${category.id}`}
  />
  <main class="max-w-screen-md mx-auto px-4 pt-6 sm:pt-8">
    <h1 class="text-4xl sm:text-5xl font-bold mb-4">
      Category: {category.data.title}
    </h1>
    <div class="content post text-lg md:text-xl">
      <Content />
    </div>
    <ul class="flex flex-col gap-6 md:gap-8">
      {
        postsInCategory.map((post) => (
          <li>
            <PostCard {post} />
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
