---
import Layout from "~/layouts/Layout.astro";
import { getCollection, getEntry } from "astro:content";
import { render } from "astro:content";
import PostMetadata from "~/components/seo/PostMetadata.astro";
import FormattedDate from "~/components/FormattedDate.astro";
import AuthorBio from "~/components/post/AuthorBio.astro";
import { getPosts } from "~/utils/getPosts";
import PostCard from "~/components/post/PostCard.astro";
import PageMetadata from "~/components/seo/PageMetadata.astro";
const params = Astro.params;
const { slug } = params;
if (slug === undefined) {
  return Astro.redirect("/404");
}
const category = await getEntry("category", slug);
if (category === undefined) {
  return Astro.redirect("/404");
}
const posts = await getPosts();
const postsInCategory = posts.filter(
  (post) => post.data.category === category.id
);

const { Content } = await render(category);

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=300, must-revalidate"
); // No browser cache
Astro.response.headers.set(
  "CDN-Cache-Control",
  "public, max-age=2592000, stale-while-revalidate=86400"
); // 30-day CDN cache
---

<Layout>
  <PageMetadata
    slot="meta"
    title={category.data.seoTitle ||
      `${category.data.title} Guides & Tutorials – Development, Optimization & Best Practices`}
    description={category.data.description}
    path={`/category/${category.id}`}
  />
  <main class="max-w-screen-md mx-auto px-4 pt-6 sm:pt-8">
    <h1 class="text-4xl sm:text-5xl font-bold mb-4">
      Category: {category.data.title}
    </h1>
    <div class="content post text-lg md:text-xl">
      <Content />
    </div>
    <ul class="flex flex-col gap-6 md:gap-8">
      {
        postsInCategory.map((post) => (
          <li>
            <PostCard {post} />
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
