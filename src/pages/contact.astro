---
import PageMetadata from "~/components/seo/PageMetadata.astro";
import Layout from "~/layouts/Layout.astro";
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=300, must-revalidate"
); // No browser cache
Astro.response.headers.set(
  "CDN-Cache-Control",
  "public, max-age=2592000, stale-while-revalidate=86400"
); // 30-day CDN cache
---

<Layout>
  <PageMetadata
    slot="meta"
    title="Contact Dipankar Maikap – Get in Touch for Tech Inquiries & Collaboration"
    description="Reach out to Dipankar Maikap for tech collaborations, developer resources, and inquiries. Connect for JavaScript, React, Node.js, and web development discussions."
    path="/contact"
  />
  <main class="max-w-screen-md mx-auto p-4 text-lg md:text-xl">
    <h1 class="text-4xl sm:text-5xl font-bold my-2">Contact</h1>
    <p class="text-2xl font-semibold my-2">
      Have a question? Want to work with me? Just want to say Hi? I’d love to
      hear from you!
    </p>
    <p>
      Use the form below to send me a message or send me an email to
      mail[at]dipankarmaikap.com and I’ll get back to you within the next day.
    </p>
  </main>
</Layout>
