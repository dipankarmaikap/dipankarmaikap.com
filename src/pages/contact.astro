---
import ContactForm from "~/components/ContactForm.astro";
// import TemplateOne from "~/components/og/TemplateOne.astro";
import PageMetadata from "~/components/seo/PageMetadata.astro";
import Layout from "~/layouts/Layout.astro";
export const prerender = true;
---

<Layout>
  <PageMetadata
    slot="meta"
    title="Contact Dipankar Maikap – Get in Touch for Tech Inquiries & Collaboration"
    description="Reach out to Dipankar Maikap for tech collaborations, developer resources, and inquiries. Connect for JavaScript, React, Node.js, and web development discussions."
    path="/contact/"
  />
  <main class="max-w-screen-md mx-auto p-4 text-lg md:text-xl">
    <div class="max-w-lg">
      <h1 class="text-4xl sm:text-5xl font-bold my-2">Get in Touch</h1>
      <p class="text-2xl font-semibold my-4">
        Have a question? Want to collaborate? Or just want to say hi? I’d love
        to hear from you!
      </p>
      <p>
        Feel free to reach out via <a
          target="_blank"
          href="https://x.com/maikap_dipankar"
          class="text-blue-500 underline">X (Twitter)</a
        >
        or <a
          target="_blank"
          href="https://linkedin.com/in/dipankar-maikap"
          class="text-blue-500 underline">LinkedIn</a
        >, or simply use the form below. Whether it's a project inquiry, tech
        discussion, or just a casual chat, I’m always happy to connect!
      </p>
      <ContactForm />
    </div>
  </main>
  <!-- <TemplateOne title="Generating sitemap for a headless WP + Next.js site" /> -->
</Layout>
