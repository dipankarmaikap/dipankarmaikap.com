---
import Layout from "~/layouts/Layout.astro";
import { getEntry } from "astro:content";
import { render } from "astro:content";
import PostMetadata from "~/components/seo/PostMetadata.astro";
import FormattedDate from "~/components/FormattedDate.astro";
import AuthorBio from "~/components/post/AuthorBio.astro";
const params = Astro.params;
const { slug } = params;
if (slug === undefined) {
  return Astro.redirect("/404");
}
const post = await getEntry("post", slug);
if (post === undefined) {
  return Astro.redirect("/404");
}
const { Content, remarkPluginFrontmatter } = await render(post);
const category = await getEntry("category", post.data.category);
const categoryName = category?.data.title || "Web Development";
const categoryUrl = "/category/" + (category?.id || "web-development");

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, must-revalidate"
); // No browser cache
Astro.response.headers.set(
  "CDN-Cache-Control",
  "public, max-age=2592000, stale-while-revalidate=86400"
); // 30-day CDN cache
---

<Layout>
  <PostMetadata slot="meta" {post} />
  <article class="max-w-screen-md mx-auto p-4 text-lg md:text-xl">
    <header class="py-4 sm:py-6">
      <a
        class="bg-blue-100 text-blue-900 hover:bg-blue-200 rounded p-1"
        href={categoryUrl}
      >
        {categoryName}
      </a>
      <h1 class="text-4xl sm:text-5xl font-bold my-2">
        {post.data.title}
      </h1>
      <div class="flex items-center text-gray-600 gap-1 text-lg">
        <FormattedDate date={post.data.pubDate} />
        <span>-</span>
        <span>
          {remarkPluginFrontmatter?.minutesRead}
        </span>
      </div>
    </header>
    <div class="content post">
      <Content />
    </div>
    <footer>
      <AuthorBio />
    </footer>
  </article>
</Layout>
