---
import Layout from "~/layouts/Layout.astro";
import { getEntry } from "astro:content";
import { render } from "astro:content";
import PostMetadata from "~/components/seo/PostMetadata.astro";
const params = Astro.params;
const { slug } = params;
if (slug === undefined) {
  return Astro.redirect("/404");
}
const post = await getEntry("post", slug);
if (post === undefined) {
  return Astro.redirect("/404");
}
const { Content } = await render(post);
---

<Layout>
  <PostMetadata slot="meta" {post} />
  <article class="max-w-screen-md mx-auto p-4 text-lg md:text-xl post">
    <h1 class="text-4xl sm:text-5xl py-4 sm:py-6 font-bold">
      {post.data.title}
    </h1>
    <Content />
  </article>
</Layout>
