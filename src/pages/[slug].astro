---
import Layout from "~/layouts/Layout.astro";
import { getEntry } from "astro:content";
import { render } from "astro:content";
import PostMetadata from "~/components/seo/PostMetadata.astro";
import FormattedDate from "~/components/FormattedDate.astro";
const params = Astro.params;
const { slug } = params;
if (slug === undefined) {
  return Astro.redirect("/404");
}
const post = await getEntry("post", slug);
if (post === undefined) {
  return Astro.redirect("/404");
}
const { Content, remarkPluginFrontmatter } = await render(post);
---

<Layout>
  <PostMetadata slot="meta" {post} />
  <article class="max-w-screen-md mx-auto p-4 text-lg md:text-xl post">
    <header class="text-base pt-4 sm:pt-6">
      <div class="flex items-center text-gray-600 gap-1 mb-2">
        <FormattedDate date={post.data.pubDate} />
        <span>-</span>
        <span>
          {remarkPluginFrontmatter?.minutesRead}
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl pb-4 sm:pb-6 font-bold">
        {post.data.title}
      </h1>
    </header>
    <Content />
  </article>
</Layout>
