---
import Layout from "~/layouts/Layout.astro";
import { getEntry } from "astro:content";
import { render } from "astro:content";
import PostMetadata from "~/components/seo/PostMetadata.astro";
import FormattedDate from "~/components/FormattedDate.astro";
import AuthorBio from "~/components/post/AuthorBio.astro";
import { getPosts } from "~/utils/getPosts";
import Sidebar from "~/components/Sidebar.astro";

export const prerender = true;
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => {
    const prevPost = index > 0 ? posts[index - 1] : null;
    const nextPost = index < posts.length - 1 ? posts[index + 1] : null;

    // Filter out the current, previous, and next posts
    const otherPosts = posts.filter(
      (p) => p.id !== post.id && p.id !== prevPost?.id && p.id !== nextPost?.id,
    );
    // Shuffle and select 5 random posts for "More Links"
    const moreLinks = otherPosts.sort(() => 0.5 - Math.random()).slice(0, 3);
    return {
      params: { slug: post.id },
      props: { post, nextPost, prevPost, moreLinks },
    };
  });
}
const { post, nextPost, prevPost, moreLinks } = Astro.props;

const { Content, remarkPluginFrontmatter } = await render(post);
---

<Layout>
  <PostMetadata slot="meta" {post} />
  <main
    class="container grid grid-cols-1 xl:grid-cols-[1fr_300px] gap-12 px-4 sm:px-8"
  >
    <article class="max-w-3xl text-sm leading-relaxed">
      <header class="pb-4 sm:pb-6">
        <a href="/"> ← Back to all posts </a>
        <h1 class="text-2xl font-bold my-2">
          {post.data.title}
        </h1>
        <div
          class="flex items-center dark:text-neutral-400 text-neutral-600 gap-1"
        >
          <FormattedDate date={post.data.pubDate} />
          <span>-</span>
          <span>
            {remarkPluginFrontmatter?.minutesRead}
          </span>
        </div>
      </header>
      <div class="content post">
        <Content />
      </div>
      <footer>
        <div class="nav-links flex flex-col gap-4">
          {
            prevPost && (
              <a
                class="flex flex-col text-blue-600 hover:underline"
                href={`/${prevPost.id}/`}
              >
                <span>← Previous:</span> <span>{prevPost.data.title}</span>
              </a>
            )
          }
          {
            nextPost && (
              <a
                class="flex flex-col text-blue-600 hover:underline "
                href={`/${nextPost.id}/`}
              >
                <span>Next: →</span>
                <span>{nextPost.data.title}</span>
              </a>
            )
          }
        </div>
        <div class="more-posts mt-6">
          <p class="text-lg font-bold">More posts</p>
          <ul class="flex flex-col gap-4 sm:gap-2 mt-2">
            {
              moreLinks.map((post) => (
                <li>
                  <a
                    class="text-blue-600 hover:text-blue-500 hover:underline"
                    href={`/${post.id}/`}
                  >
                    {post.data.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </footer>
    </article>
    <Sidebar />
  </main>
</Layout>

<script>
  document
    .querySelectorAll<HTMLButtonElement>(".code-copy")
    .forEach((button) => {
      button.addEventListener("click", async () => {
        const pre = button.closest("pre");
        if (!pre) return;

        const code = pre.getAttribute("data-code");
        if (!code) return;

        await navigator.clipboard.writeText(code);
        button.textContent = "Copied!";
        setTimeout(() => {
          button.textContent = "Copy";
        }, 1500);
      });
    });
</script>
