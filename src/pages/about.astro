---
import Layout from "~/layouts/Layout.astro";
import { Image } from "astro:assets";
import AuthorImage from "~/assets/dipankar-maikap.jpg";
import PageMetadata from "~/components/seo/PageMetadata.astro";

export const prerender = true;
---

<Layout>
  <PageMetadata
    slot="meta"
    title="About Dipankar Maikap – Developer Experience Engineer & Tech Blogger"
    description="Learn about Dipankar Maikap, a Developer Relations Engineer at Storyblok. Explore expert insights, tutorials, and guides on JavaScript, React, Node.js, and modern web development."
    path="/about/"
  />
  <main class="px-4 sm:px-8 max-w-2xl leading-relaxed text-sm">
    <h1 class="text-2xl font-bold mb-8">About Me</h1>
    <Image src={AuthorImage} alt="Dipankar Maikap" class="my-4 size-60" />
    <p>
      I'm <b>Dipankar Maikap</b>, a Developer Experience Engineer at <a
        href="https://www.storyblok.com/"
        target="_blank"
        class="text-blue-600 underline"
      >
        <b>Storyblok</b>
      </a>{" "}
      and a passionate web developer specializing in JavaScript, React, and modern
      web technologies. I create content that helps developers build better, faster,
      and more scalable web applications.
    </p>
    <h2 class="text-lg font-bold my-4">What You'll Find Here</h2>
    <ul class="list-disc list-inside ml-2">
      <li><b>In-depth Tutorials</b> – Hands-on guides on web development.</li>
      <li>
        <b>Best Practices</b> – Optimized solutions and real-world insights.
      </li>
      <li>
        <b>Tech Exploration</b> – Trends, tools, and deep dives into new frameworks.
      </li>
    </ul>
    <p class="my-4">
      This site is where I document my learnings, share knowledge, and help
      developers stay ahead in the ever-evolving web landscape.
    </p>
    <p>
      Feel free to connect with me on {" "}
      <a
        class="text-blue-600 hover:underline"
        target="_blank"
        href="https://github.com/dipankarmaikap"
      >
        GitHub
      </a>, {" "}
      <a
        class="text-blue-600 hover:underline"
        target="_blank"
        href="https://x.com/maikap_dipankar"
      >
        X (Twitter)
      </a>, or {" "}
      <a
        class="text-blue-600 hover:underline"
        target="_blank"
        href="https://www.linkedin.com/in/dipankar-maikap/"
      >
        LinkedIn
      </a>.
    </p>
  </main>
</Layout>
