---
import Layout from "~/layouts/Layout.astro";
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=300, must-revalidate"
); // No browser cache
Astro.response.headers.set(
  "CDN-Cache-Control",
  "public, max-age=2592000, stale-while-revalidate=86400"
); // 30-day CDN cache
---

<Layout>
  <h1>About Me</h1>
</Layout>
