---
import { getCollection } from "astro:content";
import Layout from "~/layouts/Layout.astro";
import PostCard from "~/components/post/PostCard.astro";
import { getPaginatedPosts } from "~/utils/getPaginatedPosts";
import Pagination from "~/components/Pagination.astro";

const pageNo = 1;
const { paginatedPosts, hasNext, hasPrev, totalPages } = getPaginatedPosts(
  await getCollection("post"),
  pageNo
);
---

<Layout>
  <section class="max-w-screen-md mx-auto px-4">
    <h1 class="text-5xl sm:text-6xl py-6 sm:py-10 font-bold">My Posts</h1>
    <ul class="flex flex-col gap-6 md:gap-8">
      {
        paginatedPosts.map((post) => (
          <li>
            <PostCard {post} />
          </li>
        ))
      }
    </ul>
    <Pagination {hasNext} {hasPrev} {totalPages} {pageNo} />
  </section>
</Layout>
