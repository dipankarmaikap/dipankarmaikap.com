---
import Pagination from "~/components/Pagination.astro";
import PostCard from "~/components/post/PostCard.astro";
import ArchivePageMeta from "~/components/seo/ArchivePageMeta.astro";
import Layout from "~/layouts/Layout.astro";
import { getPosts } from "~/utils/getPosts";
import { perPage } from "~/utils/variables";

export const prerender = true;
export async function getStaticPaths() {
  const posts = await getPosts();
  const totalPages = Math.ceil(posts.length / perPage);
  const pages = Array.from({ length: totalPages }, (_, i) => i + 1).filter(
    (i) => i !== 1
  );

  return pages.map((pageNo) => {
    const startIndex = (pageNo - 1) * perPage;
    const endIndex = startIndex + perPage;
    return {
      params: { pageNo: pageNo.toString() },
      props: {
        paginatedPosts: posts.slice(startIndex, endIndex),
        hasPrev: pageNo > 1,
        hasNext: pageNo < totalPages,
        totalPages,
        pageNo,
      },
    };
  });
}
const { paginatedPosts, hasNext, hasPrev, totalPages, pageNo } = Astro.props;
---

<Layout>
  <ArchivePageMeta
    slot="meta"
    title=`Page ${pageNo} - Dipankar Maikap - Tech Blog & Developer Guides`
    description="Explore in-depth tutorials, tech insights, and guides on JavaScript, React, Node.js, and more. Learn from Dipankar Maikap's experience!"
    path=`page/${pageNo}/`
    {hasPrev}
    {hasNext}
    {pageNo}
  />
  <section class="max-w-screen-md mx-auto px-4">
    <h1 class="text-5xl sm:text-6xl py-6 sm:py-10 font-bold">My Posts</h1>
    <ul class="flex flex-col gap-6 md:gap-8">
      {
        paginatedPosts.map((post) => (
          <li>
            <PostCard {post} />
          </li>
        ))
      }
    </ul>
    <Pagination {hasNext} {hasPrev} {totalPages} {pageNo} />
  </section>
</Layout>
