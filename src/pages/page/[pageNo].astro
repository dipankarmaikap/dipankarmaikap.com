---
import { getCollection } from "astro:content";
import Pagination from "~/components/Pagination.astro";
import PostCard from "~/components/post/PostCard.astro";
import ArchivePageMeta from "~/components/seo/ArchivePageMeta.astro";
import Layout from "~/layouts/Layout.astro";
import { getPaginatedPosts } from "~/utils/getPaginatedPosts";
const params = Astro.params;
const pageNo = parseInt(params.pageNo || "1");
if (isNaN(pageNo) || pageNo < 1) {
  return Astro.redirect("/404");
}
if (pageNo === 1) {
  return Astro.redirect("/");
}
const posts = await getCollection("post");
const { totalPages, hasNext, hasPrev, paginatedPosts } = getPaginatedPosts(
  posts,
  pageNo
);
if (pageNo > totalPages) {
  return Astro.redirect("/404");
}

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, must-revalidate"
); // No browser cache
Astro.response.headers.set(
  "CDN-Cache-Control",
  "public, max-age=2592000, stale-while-revalidate=86400"
); // 30-day CDN cache
---

<Layout>
  <ArchivePageMeta
    slot="meta"
    title=`Page ${pageNo} - Dipankar Maikap - Tech Blog & Developer Guides`
    description="Explore in-depth tutorials, tech insights, and guides on JavaScript, React, Node.js, and more. Learn from Dipankar Maikap's experience!"
    path=`page/${pageNo}`
    {hasPrev}
    {hasNext}
    {pageNo}
  />
  <section class="max-w-screen-md mx-auto px-4">
    <h1 class="text-5xl sm:text-6xl py-6 sm:py-10 font-bold">My Posts</h1>
    <ul class="flex flex-col gap-6 md:gap-8">
      {
        paginatedPosts.map((post) => (
          <li>
            <PostCard {post} />
          </li>
        ))
      }
    </ul>
    <Pagination {hasNext} {hasPrev} {totalPages} {pageNo} />
  </section>
</Layout>
